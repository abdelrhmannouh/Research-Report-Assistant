# Required
GROQ_API_KEY=
TAVILY_API_KEY=

# Optional: point the Streamlit app / CLI at a running API instead of
# running the pipeline in-process, e.g. http://localhost:8000
API_URL=

# Optional overrides (defaults shown)
# MODEL=openai/gpt-oss-120b
# MAX_SEARCH_RESULTS=3
# MAX_ATTEMPTS=3

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=
